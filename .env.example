# --- LLM backend ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1
OLLAMA_EMBED_MODEL=nomic-embed-text

# --- GitHub access ---
# Personal access token with repo read scope (public repos work unauthenticated too,
# but you'll hit low rate limits without a token).
GITHUB_TOKEN=

# --- Cache / index locations ---
CACHE_DIR=.cache
